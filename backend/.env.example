# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldur. ".env" Git'e eklenmez.
PORT=3000

# Frontend'in çalıştığı adres (CORS için). Birden fazlaysa virgülle ayır.
CORS_ORIGIN=http://localhost:5173

# Yerel SQLite dosya yolu (varsayılan: data/ortak-gider.db)
DB_PATH=data/ortak-gider.db

# Turso (libSQL): ikisi de doluysa yerel dosya yerine Turso kullanılır. Yayında (Render) bunu kullan.
# TURSO_DATABASE_URL=libsql://veritabani-adin-kullanici.turso.io
# TURSO_AUTH_TOKEN=

# Oturum geçerlilik süresi (gün). Süresi dolan oturumlar otomatik silinir. Varsayılan: 7
SESSION_DAYS=7
# İlk yönetici: bu e-postayla kayıt olan (veya kayıtlı olan) hesap admin olur. Boşsa kimse otomatik admin olmaz.
ADMIN_EMAIL=

# Fiş okuma ve borç özeti için Anthropic API anahtarı.
# Boş bırakırsan yapay zeka uçları kapalı kalır, uygulamanın geri kalanı çalışır.

