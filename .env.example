# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldur. ".env" Git'e eklenmez.
PORT=3000

# Frontend'in çalıştığı adres (CORS için). Birden fazlaysa virgülle ayır.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# SQLite dosya yolu (varsayılan: data/ortak-gider.db)
DB_PATH=data/ortak-gider.db

# Oturum geçerlilik süresi (gün). Varsayılan: 7
SESSION_DAYS=7

# İlk yönetici: bu e-postayla kayıt olan hesap admin olur. Boşsa kimse otomatik admin olmaz.
ADMIN_EMAIL=

# Fiş okuma ve borç özeti için Anthropic API anahtarı.
# Boş bırakılırsa yapay zeka uçları kapalı kalır, uygulamanın geri kısmı çalışır.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
